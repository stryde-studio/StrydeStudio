---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LegalPage from "../components/LegalPage.astro";
import { termsPage } from "../i18n/legal";

const dict = termsPage.ja;
---

<Layout
  title="利用規約 — Stryde Studio"
  description="Stryde Studio の利用規約です。"
>
  <Header />
  <LegalPage
    metaLabel={dict.metaLabel}
    title1={dict.title1}
    title2={dict.title2}
    sections={dict.sections}
    established={dict.established}
    back={dict.back}
  />
  <Footer />
</Layout>
