---
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
---

<Layout title="Haku Support — Stryde Studio" description="Support information for Haku.">
  <Header />
  <main class="pt-32 md:pt-40">
    <section class="bg-white pb-24 md:pb-32">
      <div class="container-page max-w-3xl">
        <span class="meta-label">( HAKU · SUPPORT )</span>
        <h1 class="mt-6 text-3xl font-bold leading-[1.2] tracking-tight text-ink-900 sm:text-4xl md:text-5xl">
          Haku<br />Support
        </h1>
        <div class="mt-16 space-y-10 text-sm leading-loose text-ink-700 md:mt-20 md:text-base">
          <p>For help with your account, profile, or Apple Wallet pass, contact us at:</p>
          <p><a class="font-medium text-ink-900 underline underline-offset-4" href="mailto:contact@stryde.studio">contact@stryde.studio</a></p>
          <p>You can delete your account and related data from the Account screen in the app.</p>
          <p><a class="font-medium text-ink-900 underline underline-offset-4" href="/en/haku/privacy">Read the Privacy Policy</a></p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
