---
import PhoneSilhouette from "./PhoneSilhouette.astro";
---

<section class="relative pt-36 md:pt-44">
  <div class="container-page">
    <div class="grid items-center gap-16 md:grid-cols-[1.35fr_1fr] md:gap-20">
      <div>
        <span class="meta-label">( EST. 2026 / TOKYO )</span>
        <h1
          class="mt-8 text-5xl font-bold leading-[1.12] tracking-tight text-ink-900 sm:text-6xl md:text-[64px] lg:text-[80px]"
        >
          <span class="block whitespace-nowrap">心地よい距離を、</span>
          <span class="block whitespace-nowrap">デザインする。</span>
        </h1>
        <p class="mt-10 max-w-md text-sm leading-loose text-ink-700">
          Stryde Studioは、スマートフォンと人のあいだに<br
            class="hidden sm:block"
          />
          ちょうどよい余白をつくる、東京の小さなスタジオです。
        </p>
        <div class="mt-10">
          <a href="#products" class="view-more">
            <span>VIEW PRODUCTS</span>
            <span class="view-more__arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none">
                <path
                  d="M7 17L17 7M17 7H8M17 7v9"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="square"
                ></path>
              </svg>
            </span>
          </a>
        </div>
      </div>

      <div class="flex justify-center md:justify-end">
        <PhoneSilhouette />
      </div>
    </div>

    <div
      class="mt-24 grid grid-cols-2 gap-px overflow-hidden border-y border-ink-900 bg-ink-900 text-ink-900 md:grid-cols-4"
    >
      {
        [
          { k: "FOCUS", v: "集中" },
          { k: "TIME", v: "時間" },
          { k: "SLEEP", v: "睡眠" },
          { k: "DISTANCE", v: "距離" },
        ].map((item) => (
          <div class="bg-white px-6 py-8">
            <span class="meta-label">{item.k}</span>
            <div class="mt-3 text-xl font-bold tracking-tight">{item.v}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>
