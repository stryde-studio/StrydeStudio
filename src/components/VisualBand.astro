---
import QuietArt from "./QuietArt.astro";
---

<section class="bg-ink-900 text-white">
  <div class="container-page py-24 md:py-32">
    <div class="grid items-start gap-12 md:grid-cols-[auto_1fr_auto] md:gap-16">
      <span
        class="text-[11px] font-medium tracking-widest2 uppercase text-white/60"
        >( STATEMENT )</span
      >

      <p
        class="text-2xl font-bold leading-[1.5] tracking-tight text-white sm:text-3xl md:text-4xl"
      >
        Quietly,<br />
        with care.<br />
        <span class="text-white/60">
          画面の外側にある時間を、<br />
          もう一度デザインする。
        </span>
      </p>

      <div
        class="h-28 w-28 shrink-0 rounded-full bg-white ring-[1.5px] ring-mint-300 md:h-36 md:w-36"
        aria-hidden="true"
      >
      </div>
    </div>
  </div>

  <div class="relative h-[30vh] min-h-[200px] w-full overflow-hidden border-t border-white/10">
    <QuietArt variant="wave" class="absolute inset-0 h-full w-full" />
  </div>
</section>
