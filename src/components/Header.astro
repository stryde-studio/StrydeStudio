---
import { resolveLocale, t, localePath, type Locale } from "../i18n/locales";
import LangSwitch from "./LangSwitch.astro";

const lang: Locale = resolveLocale(Astro.currentLocale);
const dict = t[lang];

const home = localePath(lang, "/");
const nav = [
  { label: dict.nav.products, href: `${home === "/" ? "" : home}#products` },
  { label: dict.nav.philosophy, href: `${home === "/" ? "" : home}#philosophy` },
  { label: dict.nav.studio, href: `${home === "/" ? "" : home}#studio` },
];
---

<header class="absolute inset-x-0 top-0 z-30">
  <div class="container-page flex items-center justify-between py-6">
    <a
      href={home}
      class="flex flex-col gap-0.5 text-base font-semibold uppercase leading-none text-ink-900"
      aria-label="Stryde Studio"
    >
      <span class="grid w-[6.5rem] grid-cols-6 text-center">
        <span>S</span><span>T</span><span>R</span><span>Y</span><span>D</span><span
          >E</span
        >
      </span>
      <span class="grid w-[6.5rem] grid-cols-6 text-center">
        <span>S</span><span>T</span><span>U</span><span>D</span><span>I</span><span
          >O</span
        >
      </span>
    </a>

    <nav class="hidden items-center gap-10 md:flex">
      {nav.map((item) => <a href={item.href} class="nav-link">{item.label}</a>)}
    </nav>

    <div class="flex items-center gap-6">
      <LangSwitch />
      <a href={`${home === "/" ? "" : home}#contact`} class="btn-contact"
        >{dict.nav.contact}</a
      >
    </div>
  </div>
</header>
