<section id="philosophy" class="bg-white py-24 md:py-32">
  <div class="container-page grid gap-12 md:grid-cols-[1fr_2fr]">
    <div>
      <span class="meta-label">( PHILOSOPHY )</span>
    </div>

    <div>
      <h2
        class="text-3xl font-bold leading-[1.4] tracking-tight text-ink-900 sm:text-4xl md:text-5xl"
      >
        スマホとの心地よい距離を、<br />
        デザインする
      </h2>

      <div class="mt-10 space-y-6 text-sm leading-loose text-ink-700">
