---
import { resolveLocale, t, type Locale } from "../i18n/locales";

const lang: Locale = resolveLocale(Astro.currentLocale);
const dict = t[lang].philosophy;
---

<section id="philosophy" class="bg-white py-24 md:py-32">
  <div class="container-page grid gap-12 md:grid-cols-[1fr_2fr]">
    <div>
      <span class="meta-label">{dict.meta}</span>
    </div>

    <div>
      <h2
        class="text-3xl font-bold leading-[1.4] tracking-tight text-ink-900 sm:text-4xl md:text-5xl"
      >
        {dict.heading1}<br />
        {dict.heading2}
      </h2>

      <div class="mt-10 space-y-6 text-sm leading-loose text-ink-700">
        {dict.body.map((p) => <p>{p}</p>)}
      </div>

      <a href="#" class="view-more mt-12">
        <span>{dict.cta}</span>
        <span class="view-more__arrow" aria-hidden="true">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none">
            <path
              d="M7 17L17 7M17 7H8M17 7v9"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="square"
            ></path>
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>
