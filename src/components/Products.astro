---
type StoreLink = string | null; // string = URL, null = 準備中, undefined (omit) = 非表示

interface Product {
  num: string;
  name: string;
  category: string;
  description: string;
  glyph: string;
  iconImage?: string;
  appStore?: StoreLink;
  googlePlay?: StoreLink;
}

const products: Product[] = [
  {
    num: "01",
    name: "NekoLock",
    category: "FOCUS",
    description: "かわいい猫が見守ってくれる集中サポートアプリ。",
    glyph: "猫",
    iconImage: "/NekoLock.webp",
    appStore:
      "https://apps.apple.com/jp/app/nekolock-%E3%81%AD%E3%81%93%E3%81%A8%E3%82%B9%E3%83%9E%E3%83%9B%E4%BE%9D%E5%AD%98%E5%AF%BE%E7%AD%96/id6758571756",
    googlePlay: null,
  },
  {
    num: "02",
    name: "TodoLock",
    category: "TASKS",
    description: "やるべきことを終えるまで、スマホをそっと預ける。",
    glyph: "✓",
    iconImage: "/TodoLock.webp",
    appStore:
      "https://apps.apple.com/jp/app/todolock-%E3%82%BF%E3%82%B9%E3%82%AF%E7%AE%A1%E7%90%86-%E3%82%A2%E3%83%97%E3%83%AA%E3%83%AD%E3%83%83%E3%82%AF/id6760632571",
  },
  {
    num: "03",
    name: "SleepLock",
    category: "SLEEP",
    description: "夜に画面を閉じ、朝にやさしく解いてくれる眠りの伴走者。",
    glyph: "月",
    iconImage: "/SleepLock.webp",
    appStore:
      "https://apps.apple.com/jp/app/sleeplock-%E5%AF%9D%E3%82%8B%E5%89%8D%E3%81%AE%E3%82%B9%E3%83%9E%E3%83%9B%E4%BE%9D%E5%AD%98%E5%AF%BE%E7%AD%96/id6760681850",
  },
];
---

<section id="products" class="border-t border-ink-900 bg-white py-20 md:py-28">
  <div class="container-page">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <span class="meta-label">( PRODUCTS / 03 )</span>
        <h2
          class="mt-4 text-4xl font-bold leading-[1.1] tracking-tight text-ink-900 md:text-6xl"
        >
          あなたに合う、<br />
          距離を。
        </h2>
      </div>
      <p class="max-w-sm text-sm leading-loose text-ink-700">
        猫・タスク・睡眠。<br />
        場面ごとに「距離」を変える、3つの小さな道具。
      </p>
    </div>

    <div
      class="mt-16 grid gap-px overflow-hidden border border-ink-900 bg-ink-900 md:grid-cols-3"
    >
      {
        products.map((p) => (
          <article class="relative flex flex-col bg-white p-8 md:p-10">
            <div class="flex items-start justify-between">
              <span class="meta-label">{p.category}</span>
              <span class="text-[11px] font-medium tracking-widest2 text-ink-500">
                {p.num}
              </span>
            </div>

            <div class="mt-12 flex h-32 items-center justify-center">
              {p.iconImage ? (
                <img
                  src={p.iconImage}
                  alt={`${p.name} icon`}
                  class="h-24 w-24 rounded-[22%]"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="flex h-24 w-24 items-center justify-center rounded-full border border-ink-900 text-3xl font-bold text-ink-900">
                  {p.glyph}
                </div>
              )}
            </div>

            <div class="mt-12">
              <h3 class="text-2xl font-bold tracking-tight text-ink-900 md:text-3xl">
                {p.name}
              </h3>
              <p class="mt-3 text-sm leading-loose text-ink-700">
                {p.description}
              </p>
            </div>

            <div class="mt-10 divide-y divide-ink-900/10 border-t border-ink-900/10">
              {[
                { name: "App Store", href: p.appStore },
                { name: "Google Play", href: p.googlePlay },
              ]
                .filter((store) => store.href !== undefined)
                .map((store) =>
                store.href ? (
                  <a
                    href={store.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex items-center justify-between py-3 transition hover:text-ink-900"
                  >
                    <span class="text-[11px] font-medium tracking-widest2 uppercase text-ink-700">
                      {store.name}
                    </span>
                    <span
                      class="text-ink-900 transition group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                      aria-hidden="true"
                    >
                      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none">
                        <path
                          d="M7 17L17 7M17 7H8M17 7v9"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="square"
                        />
                      </svg>
                    </span>
                  </a>
                ) : (
                  <div class="flex items-center justify-between py-3">
                    <span class="text-[11px] font-medium tracking-widest2 uppercase text-ink-500">
                      {store.name}
                    </span>
                    <span class="text-[10px] font-medium tracking-widest2 uppercase text-ink-300">
                      準備中
                    </span>
                  </div>
                )
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
